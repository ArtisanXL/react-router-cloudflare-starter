# Copy to .dev.vars (gitignored) for local dev / preview.
# Generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-me-with-at-least-32-random-characters
# Public origin of the app. Dev server: http://localhost:5173, vite preview: http://localhost:4173
BETTER_AUTH_URL=http://localhost:5173
