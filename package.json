{
  "name": "react-router-cloudflare-starter",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "dev": "react-router dev",
    "typecheck": "wrangler types && react-router typegen && tsc -b",
    "deploy": "npm run build && wrangler deploy",
    "preview": "npm run build && vite preview",
    "cf-typegen": "wrangler types",
    "postinstall": "wrangler types",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply app-db --local",
    "db:seed:local": "for f in database/seeds/*.sql; do wrangler d1 execute app-db --local --file=\"$f\" || exit 1; done",
    "db:studio": "drizzle-kit studio --config drizzle.studio.config.ts",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run test",
    "knip": "knip",
    "prepare": "lefthook install || true",
    "setup": "npm install && node scripts/setup-dev-vars.mjs && npm run db:migrate:local && npm run db:seed:local && npm run dev"
  },
  "dependencies": {
    "better-auth": "^1.7.28",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "isbot": "^5.1.36",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.2",
    "tailwind-merge": "^3.7.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.70.1",
    "@cloudflare/vitest-plugin": "^1.9.2",
    "@libsql/client": "^0.18.0",
    "@playwright/test": "^1.65.1",
    "@react-router/dev": "^8.5.2",
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "knip": "6.48.0",
    "lefthook": "2.2.2",
    "oxfmt": "0.80.0",
    "oxlint": "1.95.0",
    "oxlint-tsgolint": "7.0.2008",
    "tailwindcss": "^4.2.2",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.0.3",
    "vitest": "^5.1.1",
    "wrangler": "^4.168.0"
  },
  "engines": {
    "node": ">=22.22.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild@0.25.12": true,
    "esbuild@0.18.20": true,
    "lefthook@2.2.2": true,
    "workerd@1.20261123.1": true,
    "workerd@1.20261117.1": true
  }
}
